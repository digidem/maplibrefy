{
  "version": 8,
  "name": "Standard-based Studio style",
  "id": "abc123",
  "owner": "someone",
  "created": "2025-01-01T00:00:00.000Z",
  "modified": "2025-06-01T00:00:00.000Z",
  "visibility": "private",
  "draft": false,
  "projection": { "name": "globe" },
  "imports": [
    {
      "id": "basemap",
      "url": "mapbox://styles/mapbox/standard",
      "config": { "theme": "faded", "showPointOfInterestLabels": false }
    }
  ],
  "schema": {
    "accent": { "type": "color", "default": "#ff0000" }
  },
  "fog": { "range": [1, 10], "color": "#fff" },
  "lights": [
    { "id": "ambient", "type": "ambient", "properties": { "intensity": 0.5 } }
  ],
  "sprite": "mapbox://sprites/someone/abc123",
  "glyphs": "mapbox://fonts/mapbox/{fontstack}/{range}.pbf",
  "sources": {
    "composite": {
      "type": "vector",
      "url": "mapbox://mapbox.mapbox-streets-v8"
    },
    "weather": { "type": "raster-array", "url": "mapbox://someone.weather" },
    "buildings": { "type": "model", "url": "mapbox://someone.models" }
  },
  "layers": [
    { "id": "sky", "type": "sky", "paint": { "sky-type": "atmosphere" } },
    {
      "id": "water",
      "type": "fill",
      "source": "composite",
      "source-layer": "water",
      "slot": "bottom",
      "paint": {
        "fill-color": ["hsl", 200, 60, 50],
        "fill-emissive-strength": 1
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "composite",
      "source-layer": "road",
      "slot": "middle",
      "appearances": [{ "name": "night", "paint": { "line-color": "#000" } }],
      "filter": [
        "all",
        ["==", ["get", "class"], "primary"],
        [">=", ["zoom"], ["pitch"]]
      ],
      "layout": {
        "line-join": "foo",
        "line-cap": "round",
        "line-sort-key": ["distance-from-center"]
      },
      "paint": {
        "line-color": ["config", "accent"],
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          5,
          1,
          15,
          ["*", 4, ["measure-light", "brightness"]]
        ],
        "line-z-offset": 2,
        "line-opacity": ["interpolate", ["linear"], ["pitch"], 0, 1, 60, 0.5]
      }
    },
    {
      "id": "poi",
      "type": "symbol",
      "source": "composite",
      "source-layer": "poi_label",
      "layout": {
        "symbol-z-elevate": true,
        "text-field": ["get", "name"],
        "text-size": ["step", ["distance-from-center"], 12, 1, 10]
      },
      "paint": {
        "text-color": ["hsla", ["get", "hue"], 50, ["+", 40, 10], 0.8]
      }
    },
    {
      "id": "models",
      "type": "model",
      "source": "buildings",
      "source-layer": "models"
    },
    { "id": "wind", "type": "raster-particle", "source": "weather" },
    { "id": "weather-raster", "type": "raster", "source": "weather" },
    {
      "id": "bg",
      "type": "background",
      "paint": { "background-color": "#fff" }
    }
  ]
}
